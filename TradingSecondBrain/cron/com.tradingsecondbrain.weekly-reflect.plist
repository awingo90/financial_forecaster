<?xml version="1.0" encoding="UTF-8"?>
<!--
  Weekly Reflection — Sundays 23:00 local.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tradingsecondbrain.weeklyreflect</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "$HOME/TradingSecondBrain" &amp;&amp; ./cron/run_reflect.sh &gt;&gt; "$HOME/TradingSecondBrain/cron/reflect.log" 2&gt;&amp;1</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>0</integer>
        <key>Hour</key><integer>23</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/tsb-reflect.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tsb-reflect.err</string>
</dict>
</plist>
