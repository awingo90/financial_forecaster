# Copy to .env and fill in. Never commit .env.

# --- Vault ---
VAULT_PATH=${HOME}/TradingSecondBrain/obsidian-vault

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=qwen3:32b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Optional cloud fallback (off by default; flip ALLOW_CLOUD_LLM=true to opt in) ---
ALLOW_CLOUD_LLM=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Vector store ---
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=trading_vault
CHROMA_PATH=./chroma_storage

# --- Obsidian Local REST API ---
# After installing the plugin, copy the API key it generates and paste it here.
OBSIDIAN_API_URL=http://127.0.0.1:27124
OBSIDIAN_API_KEY=

# --- Market data ---
POLYGON_API_KEY=

# --- API server (used by n8n + cron) ---
API_HOST=127.0.0.1
API_PORT=8088
API_TOKEN=changeme-local-token
