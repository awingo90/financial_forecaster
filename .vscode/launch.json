{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Python: Financial Forecaster",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/financial_forecaster.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": [
                "--create",
                "--output",
                "MyForecast.xlsx"
            ]
        }
    ]
}